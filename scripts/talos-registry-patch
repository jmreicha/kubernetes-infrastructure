#!/usr/bin/env bash
# Render Talos RegistryMirrorConfig documents that send each cached registry through zot,
# the opt-in pull-through cache (spec/core). Talos falls back to upstream if zot is down.
# Usage: scripts/talos-registry-patch clusters/<name>.yaml > registry-patch.yaml
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
values=${1:?usage: scripts/talos-registry-patch clusters/<name>.yaml}
[ "$(yq '(.enable // []) | any_c(. == "zot")' "$values")" = true ] || {
  echo "talos-registry-patch: the cluster values must set enable: [zot] and pullThroughCacheIp" >&2
  exit 1
}
ip=$(yq .pullThroughCacheIp "$values")
yq -r '.pullThroughCacheRegistries | keys | .[]' "$root/cluster/values.yaml" | while read -r host; do
  echo ---
  url="http://$ip:5000/v2/$host"
  export host url
  yq -n '
    .apiVersion = "v1alpha1" | .kind = "RegistryMirrorConfig" | .name = strenv(host) |
    .endpoints = [{"url": strenv(url), "overridePath": true}]'
done
