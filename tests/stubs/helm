#!/usr/bin/env bash
# Test stub: `template` runs the real helm; install/upgrade calls are recorded only.
if [ "$1" = template ]; then exec "$REAL_HELM" "$@"; fi
echo "helm $*" >>"$CALLS"
# Keep each release's values file (helm upgrade --install <release> ... -f <file>) for assertions.
if [ "$1" = upgrade ]; then
  prev=""
  for a in "$@"; do
    [ "$prev" = -f ] && cp "$a" "$CALLS.$3.values"
    prev=$a
  done
fi
exit 0
